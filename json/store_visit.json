{
  "version": "7.0",
  "data_api_version": "3.0",
  "routing_model": {
    "SV_DETAILS": [
      "SV_DATETIME"
    ],
    "SV_DATETIME": []
  },
  "screens": [
    {
      "id": "SV_DETAILS",
      "title": "Schedule a Store Visit!",
      "data": {
        "looking_for_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          },
          "__example__": [
            {
              "id": "diamond_jewellery",
              "title": "Diamond Jewellery"
            }
          ]
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          },
          "__example__": [
            {
              "id": "Punjab",
              "title": "Punjab"
            }
          ]
        },
        "cities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          },
          "__example__": [
            {
              "id": "_none",
              "title": "Select a state first",
              "enabled": false
            }
          ]
        },
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          },
          "__example__": [
            {
              "id": "_none",
              "title": "Select a city first",
              "enabled": false
            }
          ]
        },
        "details_error": {
          "type": "string",
          "__example__": ""
        },
        "init_values": {
          "type": "object",
          "properties": {
            "first_name": {
              "type": "string"
            },
            "last_name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            },
            "looking_for": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "city": {
              "type": "string"
            }
          },
          "__example__": {
            "first_name": "Priya",
            "last_name": "",
            "email": "",
            "phone": "919812345678",
            "looking_for": "",
            "state": "",
            "city": ""
          }
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "details_form",
            "init-values": "${data.init_values}",
            "children": [
              {
                "type": "TextHeading",
                "text": "Find Your Nearest Store"
              },
              {
                "type": "TextInput",
                "name": "first_name",
                "label": "First Name",
                "required": true,
                "input-type": "text"
              },
              {
                "type": "TextInput",
                "name": "last_name",
                "label": "Last Name",
                "required": false,
                "input-type": "text"
              },
              {
                "type": "TextInput",
                "name": "email",
                "label": "Email ID",
                "required": false,
                "input-type": "email"
              },
              {
                "type": "TextInput",
                "name": "phone",
                "label": "Phone No",
                "required": false,
                "input-type": "phone",
                "helper-text": "Leave blank to use this WhatsApp number"
              },
              {
                "type": "Dropdown",
                "name": "looking_for",
                "label": "Looking for",
                "required": true,
                "data-source": "${data.looking_for_options}"
              },
              {
                "type": "Dropdown",
                "name": "state",
                "label": "Select your State",
                "required": true,
                "data-source": "${data.states}",
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "state",
                    "state": "${form.state}",
                    "first_name": "${form.first_name}",
                    "last_name": "${form.last_name}",
                    "email": "${form.email}",
                    "phone": "${form.phone}",
                    "looking_for": "${form.looking_for}"
                  }
                }
              },
              {
                "type": "Dropdown",
                "name": "city",
                "label": "Select your City",
                "required": true,
                "data-source": "${data.cities}",
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "city",
                    "state": "${form.state}",
                    "city": "${form.city}",
                    "first_name": "${form.first_name}",
                    "last_name": "${form.last_name}",
                    "email": "${form.email}",
                    "phone": "${form.phone}",
                    "looking_for": "${form.looking_for}"
                  }
                }
              },
              {
                "type": "Dropdown",
                "name": "store_id",
                "label": "Nearest Kisna Store",
                "required": true,
                "data-source": "${data.stores}"
              },
              {
                "type": "TextBody",
                "text": "${data.details_error}"
              },
              {
                "type": "Footer",
                "label": "Next",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "store",
                    "state": "${form.state}",
                    "city": "${form.city}",
                    "store_id": "${form.store_id}",
                    "first_name": "${form.first_name}",
                    "last_name": "${form.last_name}",
                    "email": "${form.email}",
                    "phone": "${form.phone}",
                    "looking_for": "${form.looking_for}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SV_DATETIME",
      "title": "Choose Date & Time",
      "terminal": true,
      "data": {
        "first_name": {
          "type": "string",
          "__example__": ""
        },
        "last_name": {
          "type": "string",
          "__example__": ""
        },
        "email": {
          "type": "string",
          "__example__": ""
        },
        "phone": {
          "type": "string",
          "__example__": ""
        },
        "looking_for": {
          "type": "string",
          "__example__": ""
        },
        "store_id": {
          "type": "string",
          "__example__": "F203"
        },
        "store_name": {
          "type": "string",
          "__example__": "INA Colony - Amritsar - Punjab"
        },
        "store_address": {
          "type": "string",
          "__example__": "Mall Road, Amritsar 143001"
        },
        "min_date": {
          "type": "string",
          "__example__": "2026-09-30"
        },
        "max_date": {
          "type": "string",
          "__example__": "2026-10-06"
        },
        "unavailable_dates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "__example__": [
            "2026-10-02"
          ]
        },
        "selected_date": {
          "type": "string",
          "__example__": ""
        },
        "time_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          },
          "__example__": [
            {
              "id": "11:30",
              "title": "11:30 AM"
            }
          ]
        },
        "slot_error": {
          "type": "string",
          "__example__": ""
        },
        "init_values": {
          "type": "object",
          "properties": {
            "preferred_date": {
              "type": "string"
            }
          },
          "__example__": {
            "preferred_date": "2026-09-30"
          }
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "datetime_form",
            "init-values": "${data.init_values}",
            "children": [
              {
                "type": "TextSubheading",
                "text": "${data.store_name}"
              },
              {
                "type": "TextCaption",
                "text": "${data.store_address}"
              },
              {
                "type": "DatePicker",
                "name": "preferred_date",
                "label": "Visit date",
                "required": true,
                "min-date": "${data.min_date}",
                "max-date": "${data.max_date}",
                "unavailable-dates": "${data.unavailable_dates}",
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "date",
                    "store_id": "${data.store_id}",
                    "preferred_date": "${form.preferred_date}",
                    "first_name": "${data.first_name}",
                    "last_name": "${data.last_name}",
                    "email": "${data.email}",
                    "phone": "${data.phone}",
                    "looking_for": "${data.looking_for}"
                  }
                }
              },
              {
                "type": "TextBody",
                "text": "${data.slot_error}"
              },
              {
                "type": "Dropdown",
                "name": "preferred_time",
                "label": "Visit time",
                "required": true,
                "data-source": "${data.time_slots}"
              },
              {
                "type": "Footer",
                "label": "Submit",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "request_type": "store_visit",
                    "store_id": "${data.store_id}",
                    "preferred_date": "${form.preferred_date}",
                    "preferred_time": "${form.preferred_time}",
                    "first_name": "${data.first_name}",
                    "last_name": "${data.last_name}",
                    "email": "${data.email}",
                    "phone": "${data.phone}",
                    "looking_for": "${data.looking_for}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
