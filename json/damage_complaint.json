{
  "screens": [
    {
      "data": {},
      "id": "RECOMMEND",
      "layout": {
        "children": [
          {
            "children": [
              {
                "type": "TextSubheading",
                "text": "Tell us what went wrong and how to reach you."
              },
              {
                "data-source": [
                  {"id": "1_Order_Related", "title": "Order Related"},
                  {"id": "2_Payment_Related", "title": "Payment Related"},
                  {"id": "3_Stores_Related", "title": "Stores Related"},
                  {"id": "4_Returns_Related", "title": "Returns Related"},
                  {"id": "5_Exchange_Buyback", "title": "Exchange/Buyback"},
                  {"id": "6_Digital_Gold", "title": "Digital Gold"},
                  {"id": "7_Kisna_Points", "title": "Kisna Points (KMR)"},
                  {"id": "8_10_Plus_1_Monthly_Plan", "title": "10+1 Monthly Plan (KMR)"},
                  {"id": "9_Other", "title": "Other / General"}
                ],
                "label": "Complaint Type",
                "name": "complaint_type",
                "required": true,
                "type": "Dropdown"
              },
              {
                "input-type": "text",
                "label": "Order ID",
                "name": "order_id",
                "required": false,
                "helper-text": "For order, payment, return or exchange issues. Skip if you don't have one.",
                "type": "TextInput"
              },
              {
                "input-type": "number",
                "label": "Registered Mobile Number",
                "name": "registered_mobile",
                "required": false,
                "helper-text": "For order or payment issues — the mobile number on your Kisna account.",
                "type": "TextInput"
              },
              {
                "input-type": "text",
                "label": "Registered Email or Contact Number",
                "name": "registered_contact",
                "required": false,
                "helper-text": "For KMR, Digital Gold, store or general queries — how we identify your account.",
                "type": "TextInput"
              },
              {
                "input-type": "text",
                "label": "Invoice Number",
                "name": "invoice_number",
                "required": false,
                "helper-text": "For store-related issues, if you have the invoice.",
                "type": "TextInput"
              },
              {
                "label": "Describe your issue",
                "name": "issue_description",
                "required": true,
                "helper-text": "For payment issues, include the transaction ID, amount and date.",
                "type": "TextArea"
              },
              {
                "label": "Submit Complaint",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "complaint_type": "${form.complaint_type}",
                    "order_id": "${form.order_id}",
                    "registered_mobile": "${form.registered_mobile}",
                    "registered_contact": "${form.registered_contact}",
                    "invoice_number": "${form.invoice_number}",
                    "issue_description": "${form.issue_description}"
                  }
                },
                "type": "Footer"
              }
            ],
            "name": "flow_path",
            "type": "Form"
          }
        ],
        "type": "SingleColumnLayout"
      },
      "terminal": true,
      "title": "KISNA Complaint"
    }
  ],
  "version": "7.0"
}
