{
  "_meta": {
    "purpose": "Multilingual classifier regression set for the prompt-remediation stages.",
    "buckets": {
      "gu-native": "Gujarati native script",
      "hi-native": "Devanagari Hindi",
      "romanized": "Romanized regional (Gujarati / Marathi / Hinglish)",
      "store": "store_info true positives",
      "contrast": "store-vs-product contrast pairs (same phrasing, different object)",
      "context": "context-dependent follow-ups"
    },
    "context_keys": {
      "active_search": "user has an active jewellery search (last_search_filters set)",
      "shown_products": "numbered list of products currently on screen",
      "store_wait": "awaiting_store_pincode is set"
    },
    "expect_entities": "only the fields asserted; a field set to null must be null/absent in the output"
  },

